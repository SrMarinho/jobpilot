APP_NAME = "Linkeding RPA"
LOG_LEVEL = "DEBUG"
HEADLESS="False"

# ── Identidade (OBRIGATÓRIO) ────────────────────────────────────────────────
# Nome e headline que assinam posts, comentários e DMs no LinkedIn.
# Sem estes, os comandos de conteúdo falham com erro explícito — de propósito:
# um default aqui significaria publicar assinando com o nome de outra pessoa.
USER_NAME=
USER_HEADLINE=

# Parte final do URL do perfil: /in/<slug>/
LINKEDIN_PROFILE_SLUG=

# ── LLM ─────────────────────────────────────────────────────────────────────
# LLM provider: "langchain" (default) or "claude"
LLM_PROVIDER=langchain

# Claude settings (usado quando LLM_PROVIDER=claude)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# LangChain settings (usado quando LLM_PROVIDER=langchain)
LANGCHAIN_BACKEND=ollama          # ollama (local) ou deepseek (API remota)
LANGCHAIN_MODEL=llama3.2
LANGCHAIN_BASE_URL=http://localhost:11434

# Provider separado para avaliação de vagas (opcional, usa LLM_PROVIDER se não definido)
LLM_PROVIDER_EVAL=claude
LANGCHAIN_BACKEND_EVAL=ollama
LANGCHAIN_MODEL_EVAL=llama3.1:8b

# Chaves de API (uma por provider). Salvar via: provider key set <provider> <chave>
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Telegram ────────────────────────────────────────────────────────────────
# Sem token/chat_id, todas as notificações e o bot viram no-op silencioso.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional: DM que recebe as aprovações. Vazio => usa TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_ID=

# ── Engage (todos opcionais) ────────────────────────────────────────────────
# Pipeline multi-modelo: um modelo gera, um critica, um comprime.
ENGAGE_GENERATOR_MODEL=claude-sonnet-5
ENGAGE_REVIEWER_MODEL=claude-opus-5-5
ENGAGE_COMPRESSOR_MODEL=claude-haiku-4-5-20251001
# 0 desliga o pipeline e volta ao provider único.
ENGAGE_CLAUDE_PIPELINE=1
# Mínimo de palavras na legenda p/ o post ser comentável (menos = alucinação).
ENGAGE_MIN_CAPTION_WORDS=40
# 1 = só engaja com post de quem é da área.
ENGAGE_AUTHOR_DEV_ONLY=1
# 1 = só comenta em post que faz pergunta.
ENGAGE_QUESTION_ONLY=1
# 1 = pula o filtro de relevância (debug).
ENGAGE_SKIP_RELEVANCE=0

# ── Autopost (opcional) ─────────────────────────────────────────────────────
# Mesmo padrão do engage: um modelo gera+reescreve, outro critica.
AUTOPOST_GENERATOR_MODEL=
AUTOPOST_REVIEWER_MODEL=

# ── Segurança de conta ──────────────────────────────────────────────────────
# Tetos proativos por ação: o run para sozinho ao atingir, em vez de esperar o
# LinkedIn reclamar. 0 desliga o limite daquela janela.
# Padrões: connect 25/dia 100/sem · apply 30/150 · engage 20/100 · dm 15/60
LIMIT_CONNECT_DAY=25
LIMIT_CONNECT_WEEK=100
LIMIT_APPLY_DAY=30
LIMIT_APPLY_WEEK=150
LIMIT_ENGAGE_DAY=20
LIMIT_ENGAGE_WEEK=100
LIMIT_DM_DAY=15
LIMIT_DM_WEEK=60

# Fora dessa janela, runs agendados não agem (os triggers são de logon, então
# sem isso o bot age a qualquer hora que a máquina ligar).
ACTIVE_HOURS=07:00-23:00

# Ritmo das ações: fast (sessão manual) | normal | cautious (conta sensível).
PACING_PROFILE=normal

# ── Persistência ────────────────────────────────────────────────────────────
# Vazio => modo JSON local (.local/files). Setado => Postgres remoto.
# Use o endpoint pooled (pgbouncer) do provedor (Neon/Supabase). Ex:
# DATABASE_URL=postgresql://user:pass@host:6543/dbname
DATABASE_URL=

# ── Autoevolução (ver docs/evolution.md) ────────────────────────────────────
# Três travas independentes, em ordem de risco crescente. Todas desligadas por
# default: um sistema que altera o próprio código não se liga sozinho.
#
# 1) Cura de selector dentro do run. Não toca no código-fonte: o selector
#    aprendido vive no banco e o run continua de onde parou. Comece por aqui.
EVOLVE_HEAL=false
# 2) Patch em git worktree isolado (ruff + pytest + smoke) e commit local.
EVOLVE_ENABLED=false
# 3) Empurra a branch evolve/* pro GitHub. ANTES de ligar: configure branch
#    protection na master — é a única trava que não depende do nosso código.
EVOLVE_PUSH=false

# Tetos da cura. A cura roda com o lock do browser na mão (teto de 600s), então
# estes números são pequenos de propósito.
# EVOLVE_MAX_HEALS_PER_RUN=2
# EVOLVE_MAX_HEAL_SECONDS_PER_RUN=60
# LIMIT_HEAL_DAY=5
# LIMIT_HEAL_WEEK=20

# Modelos. O da cura só devolve seletores (tarefa barata); o do patch escreve
# código e roda sem Bash, WebFetch e WebSearch.
# EVOLVE_HEAL_MODEL=claude-haiku-4-5-20251001
# EVOLVE_PATCH_MODEL=claude-sonnet-5
# EVOLVE_PATCH_TIMEOUT_S=420
# EVOLVE_PATCH_MAX_TURNS=24

# Preserva o worktree quando o patch reprova, para inspeção manual.
# EVOLVE_KEEP_FAILED=1

# Injeção de falha: troca os candidatos declarados do campo por um selector
# morto, para verificar a cura de ponta a ponta sem esperar o site quebrar.
# EVOLVE_FAULT_FIELD=linkedin job title
